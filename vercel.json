{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "express",
      "entrypoint": "api/index.js",
      "bindings": [
        {
          "type": "service",
          "service": "python",
          "format": "url",
          "env": "PYTHON_URL"
        }
      ]
    },
    "python": {
      "root": "python",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
